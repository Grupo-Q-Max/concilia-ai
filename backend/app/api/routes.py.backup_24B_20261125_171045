                409,
                "Baixa bloqueada por inconsistencia contabil."
            )

        conn.commit()

        return {
            **result,
            "composition_total": after["total"],
            "composition_difference": after["difference"],
            "opening_difference": after["opening_difference"],
            "refresh_required": True
        }

