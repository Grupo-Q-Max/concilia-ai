"use client";
import React, {useState} from "react";
import {attachOpening,api} from "@/lib/api";
export const BalanceCompositionTable: React.FC<{job:any;summary:any;openItems:any[];divergentItems:any[];onOpenAudit:()=>void}> = ({job,summary,onOpenAudit}) => {
 const [updated,setUpdated]=useState<any>(null); const [error,setError]=useState(""); const [busy,setBusy]=useState(false); const [search,setSearch]=useState("");
 const c=updated?.id===job?.id?updated.data:summary?.composition_v3;
 const fmt=(v:any)=>Number(v||0).toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
 if(!c)return <div>Composição indisponível.</div>;
 return <div className="space-y-4 bg-white p-5 rounded-xl"><h2 className="text-xl font-bold">Composição analítica do saldo final</h2><p>Débito positivo; crédito negativo.</p><div className="grid grid-cols-3 gap-4"><div>Saldo do razão<br/><b>{fmt(c.reported)}</b></div><div>Saldo composto<br/><b>{fmt(c.total)}</b></div><div>Diferença<br/><b>{fmt(c.difference)}</b></div></div><p>{c.valid?"Composição matematicamente exata":"Composição divergente — revisar lançamentos"}</p><button onClick={onOpenAudit}>Ver memória de cálculo</button>{Number(job.initial_balance)!==0&&<div className="border p-4 rounded"><b>Saldo anterior: {fmt(job.initial_balance)}</b><p>Aceita Data, Numero, Historico, Valor (com ou sem cabecalho), ou Fornecedor, NF, Emissao, Saldo anterior, Natureza (D/C). Valores positivos.</p><p>{c.opening_attached?"Detalhamento anexado":"Sem detalhamento anterior"}</p>{c.opening_attached && !c.opening_complete && <p className="text-amber-700 font-semibold">Saldo anterior ainda não comprovado: {fmt(c.opening_difference)}. A diferença está demonstrada separadamente.</p>}<input type="file" accept=".xls,.xlsx" disabled={busy} onChange={async e=>{const f=e.target.files?.[0];if(!f)return;setBusy(true);setError("");try{await attachOpening(job.id,f);const r=await api.getSummary(job.id);setUpdated({id:job.id,data:r.summary.composition_v3});}catch(e:any){setError(e.message);}finally{setBusy(false);e.target.value="";}}}/><p>{error}</p></div>}<input className="border p-2" placeholder="Buscar NF, fornecedor ou histórico" value={search} onChange={e=>setSearch(e.target.value)}/><div className="overflow-auto"><table className="w-full text-xs"><thead><tr>{["Origem","Data","NF","Fornecedor","Histórico","Original","Residual"].map(x=><th key={x} className="p-2 text-left">{x}</th>)}</tr></thead><tbody>{c.rows.filter((r:any)=>JSON.stringify(r).toLowerCase().includes(search.toLowerCase())).map((r:any,i:number)=><tr key={i} className="border-t">{[r.kind,r.date,r.nf,r.supplier,r.history,fmt(r.original),fmt(r.value)].map((x:any,j:number)=><td key={j} className="p-2">{x}</td>)}</tr>)}</tbody></table></div></div>;
};
